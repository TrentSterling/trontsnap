#!/bin/sh
# Refresh desktop + icon caches so the launcher shows up without a re-login.
# Each step is optional and none may fail the install: dpkg triggers cover most
# systems already, and a headless box has neither tool.
set -e

case "$1" in
    configure)
        if command -v update-desktop-database >/dev/null 2>&1; then
            update-desktop-database -q /usr/share/applications || true
        fi
        if command -v gtk-update-icon-cache >/dev/null 2>&1; then
            gtk-update-icon-cache -q -t -f /usr/share/icons/hicolor || true
        fi
        ;;
esac

exit 0
